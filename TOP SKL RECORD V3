-- Función para obtener posición del mundo
local function getWorldPosition()
    local ray = Camera:ScreenPointToRay(Mouse.X, Mouse.Y)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    
    local result = Workspace:Raycast(ray.Origin, ray.Direction * 2000, raycastParams)
    if result then
        return result.Position, result.Normal, result.Instance
    end
    return nil, nil, nil
end

-- Función para registrar acción
local function recordAction(actionType, data)
    if not RECORDING then return end
    
    local currentTime = tick() - startTime
    table.insert(actions, {
        time = currentTime,
        type = actionType,
        data = data or {}
    })
    
    CounterLabel.Text = "Acciones: " .. #actions
end

-- Función para reproducir acción
local function playAction(action)
    if action.type == "click" then
        local clickData = action.data
        if clickData.worldPos then
            pcall(function()
                for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                    if remote:IsA("RemoteEvent") then
                        local name = remote.Name:lower()
                        if string.find(name, "click") or string.find(name, "place") or string.find(name, "build") then
                            remote:FireServer(clickData.worldPos, clickData.target, clickData.normal)
                        end
                    end
                end
            end)
            
            pcall(function()
                local VirtualInputManager = game:GetService("VirtualInputManager")
                VirtualInputManager:SendMouseButtonEvent(clickData.screenX, clickData.screenY, 0, true, game, 1)
                wait(0.03)
                VirtualInputManager:SendMouseButtonEvent(clickData.screenX, clickData.screenY, 0, false, game, 1)
            end)
        end
        
    elseif action.type == "keypress" then
        local keyData = action.data
        pcall(function()
            local VirtualInputManager = game:GetService("VirtualInputManager")
            VirtualInputManager:SendKeyEvent(true, keyData.keyCode, false, game)
            wait(0.03)
            VirtualInputManager:SendKeyEvent(false, keyData.keyCode, false, game)
        end)
        
    elseif action.type == "upgrade" then
        pcall(function()
            for _, gui in pairs(LocalPlayer.PlayerGui:GetDescendants()) do
                if gui:IsA("TextButton") and gui.Visible then
                    local text = gui.Text:lower()
                    if string.find(text, "upgrade") or string.find(text, "mejorar") or string.find(text, "level") then
                        gui.MouseButton1Click:Fire()
                    end
                end
            end
        end)
        
    elseif action.type == "sell" then
        pcall(function()
            for _, gui in pairs(LocalPlayer.PlayerGui:GetDescendants()) do
                if gui:IsA("TextButton") and gui.Visible then
                    local text = gui.Text:lower()
                    if string.find(text, "sell") or string.find(text, "vender") then
                        gui.MouseButton1Click:Fire()
                    end
                end
            end
        end)
        
    elseif action.type == "place_unit" then
        local unitData = action.data
        if unitData.unitName and unitData.worldPos then
            pcall(function()
                for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                    if remote:IsA("RemoteEvent") then
                        local name = remote.Name:lower()
                        if string.find(name, "place") or string.find(name, "spawn") or string.find(name, "buy") then
                            remote:FireServer(unitData.unitName, unitData.worldPos)
                        end
                    end
                end
            end)
        end
        
    elseif action.type == "remove_unit" then
        pcall(function()
            for _, gui in pairs(LocalPlayer.PlayerGui:GetDescendants()) do
                if gui:IsA("TextButton") and gui.Visible then
                    local text = gui.Text:lower()
                    if string.find(text, "remove") or string.find(text, "quitar") or string.find(text, "delete") then
                        gui.MouseButton1Click:Fire()
                    end
                end
            end
        end)
    end
end

