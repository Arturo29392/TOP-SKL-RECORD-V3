local function stopRecording()
    RECORDING = false
    StatusLabel.Text = "Grabación detenida - " .. #actions .. " acciones"
    StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    StartBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    StartBtn.Text = "START RECORDING"
end

local function startPlayback()
    if #actions == 0 then
        StatusLabel.Text = "No hay acciones guardadas"
        return
    end
    
    PLAYING = true
    currentIndex = 1
    StatusLabel.Text = "REPRODUCIENDO..."
    StatusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
    PlayBtn.BackgroundColor3 = Color3.fromRGB(30, 80, 140)
    PlayBtn.Text = "PAUSA"
    
    spawn(function()
        repeat
            while PLAYING and currentIndex <= #actions do
                local action = actions[currentIndex]
                local waitTime = 0
                
                if currentIndex > 1 then
                    waitTime = action.time - actions[currentIndex - 1].time
                else
                    waitTime = action.time
                end
                
                if waitTime > 0 then
                    wait(waitTime)
                end
                
                if PLAYING then
                    playAction(action)
                    currentIndex = currentIndex + 1
                    StatusLabel.Text = "Reproduciendo... (" .. currentIndex .. "/" .. #actions .. ")"
                end
            end
            
            if loopPlayback and PLAYING then
                currentIndex = 1
                wait(0.5)
            end
        until not loopPlayback or not PLAYING
        
        if not PLAYING then
            StatusLabel.Text = "Reproducción pausada"
        else
            StatusLabel.Text = "Reproducción completada"
            PLAYING = false
        end
        
        PlayBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 200)
        PlayBtn.Text = "AUTO PLAY"
    end)
end

local function pausePlayback()
    PLAYING = false
    StatusLabel.Text = "Pausado - " .. currentIndex .. "/" .. #actions
    StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    PlayBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 200)
    PlayBtn.Text = "AUTO PLAY"
end

local function toggleLoop()
    loopPlayback = not loopPlayback
    if loopPlayback then
        LoopBtn.BackgroundColor3 = Color3.fromRGB(80, 30, 120)
        LoopBtn.Text = "LOOP ON"
    else
        LoopBtn.BackgroundColor3 = Color3.fromRGB(120, 50, 180)
        LoopBtn.Text = "LOOP MODE"